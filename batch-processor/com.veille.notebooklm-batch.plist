<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.veille.notebooklm-batch</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>~/second-brain/batch-processor/run-notebooklm-batch-in-kiro.sh</string>
    </array>
    
    <key>StartCalendarInterval</key>
    <array>
        <!-- 9h00 -->
        <dict>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <!-- 14h00 -->
        <dict>
            <key>Hour</key>
            <integer>14</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <!-- 19h00 -->
        <dict>
            <key>Hour</key>
            <integer>19</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <!-- 20h00 TEST -->
        <dict>
            <key>Hour</key>
            <integer>20</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>
    
    <key>StandardOutPath</key>
    <string>~/second-brain/batch-processor/batch-notebooklm.log</string>
    
    <key>StandardErrorPath</key>
    <string>~/second-brain/batch-processor/batch-notebooklm-error.log</string>
    
    <key>WorkingDirectory</key>
    <string>~/second-brain</string>
</dict>
</plist>
