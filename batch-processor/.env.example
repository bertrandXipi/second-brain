# GitHub (mêmes valeurs que le bot Discord)
GITHUB_REPO_URL=https://github.com/your-org/fiches-veille.git
GITHUB_BRANCH=main
GITHUB_PAT=your_github_pat_here
GIT_AUTHOR_NAME=Batch Processor
GIT_AUTHOR_EMAIL=batch@fiches-veille.local

# Discord webhook pour notifications (optionnel)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Chemin vers le vault Obsidian local (optionnel)
OBSIDIAN_VAULT_PATH=/Users/bertrand/Sites/fiches-veille

# Chemin vers le prompt (optionnel, défaut: prompts/v1.txt)
# PROMPT_PATH=./prompts/v1.txt

# NotebookLM MCP Server
# URL du serveur MCP NotebookLM (local ou distant)
# Pour changer de compte NotebookLM, voir: ../docs/CHANGE-NOTEBOOKLM-ACCOUNT.md
NOTEBOOKLM_MCP_URL=http://127.0.0.1:8000/mcp
